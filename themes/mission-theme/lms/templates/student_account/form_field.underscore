<%
    var fieldLabel = label;
    if (name === 'email') {
        fieldLabel = gettext('Adresse email');
    } else if (name === 'password') {
        fieldLabel = gettext('Mot de passe');
    } else if (name === 'name') {
        fieldLabel = gettext('Nom complet');
    } else if (name === 'username') {
        fieldLabel = gettext("Nom d'utilisateur public");
    }
%>

<% if (type === 'hidden') { %>
    <input
        id="<%- form %>-<%- name %>"
        type="hidden"
        name="<%- name %>"
        value="<%- defaultValue %>"
    />
<% } else if (type === 'checkbox') { %>
    <div class="form-field <%- type %>-<%- name %>">
        <input
            id="<%- form %>-<%- name %>"
            type="checkbox"
            name="<%- name %>"
            class="input-block checkbox"
            <% if ( defaultValue === true ) { %> checked<% } %>
            value="<%- defaultValue %>"
        />
        <label for="<%- form %>-<%- name %>">
            <span class="label-text"><%= HtmlUtils.HTML(label) %></span>
        </label>
        <span id="<%- form %>-<%- name %>-validation-error" class="tip error" aria-live="assertive">
            <span class="sr-only"></span>
            <span id="<%- form %>-<%- name %>-validation-error-msg"><ul class="fa-ul"></ul></span>
        </span>
    </div>
<% } else { %>
    <div class="field form-field <%- type %>-<%- name %>">
        <label for="<%- form %>-<%- name %>"><%- fieldLabel %></label>

        <% if ( type === 'select' ) { %>
            <select
                id="<%- form %>-<%- name %>"
                name="<%- name %>"
                class="input-inline"
                <% if ( required ) { %> required<% } %>
            >
                <% _.each(options, function(el) { %>
                    <option value="<%- el.value%>"<% if ( el.default ) { %> selected<% } %>><%- el.name %></option>
                <% }); %>
            </select>
        <% } else if ( type === 'textarea' ) { %>
            <textarea
                id="<%- form %>-<%- name %>"
                name="<%- name %>"
                class="input-block"
                <% if ( required ) { %> required<% } %>
            ></textarea>
        <% } else { %>
            <input
                id="<%- form %>-<%- name %>"
                type="<%- type %>"
                name="<%- name %>"
                class="input-block"
                <% if ( restrictions.min_length ) { %> minlength="<%- restrictions.min_length %>"<% } %>
                <% if ( restrictions.max_length && type !== 'password' ) { %> maxlength="<%- restrictions.max_length %>"<% } %>
                <% if ( required ) { %> required<% } %>
                <% if ( placeholder ) { %> placeholder="<%- placeholder %>"<% } %>
                value="<%- defaultValue %>"
            />
        <% } %>

        <span id="<%- form %>-<%- name %>-validation-error" class="tip error" aria-live="assertive">
            <span class="sr-only"></span>
            <span id="<%- form %>-<%- name %>-validation-error-msg"><ul class="fa-ul"></ul></span>
        </span>

        <% if (form === 'password-reset' && name === 'email') { %>
            <div class="hint">Saisissez l'adresse email utilisée lors de votre inscription.</div>
        <% } %>
    </div>
<% } %>

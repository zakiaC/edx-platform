<div class="js-form-feedback" aria-live="assertive" tabindex="-1"></div>

<div class="form-head">
    <h1>Mot de passe oublié</h1>
    <p>Entrez votre email pour recevoir un lien de réinitialisation.</p>
</div>

<form id="password-reset" class="password-reset-form" tabindex="-1" method="POST">
    <%= HtmlUtils.HTML(fields) %>
    <button type="submit" class="action action-primary action-update js-reset btn-submit"><span>Envoyer le lien</span></button>
</form>

<div class="form-bottom" style="margin-top:24px">
    <button type="button" class="form-toggle" data-type="login">← Retour à la connexion</button>
</div>

<div class="form-footer">
    <a href="#">Mentions légales</a> · <a href="#">RGPD</a> · <a href="#">Aide</a><br>
    © 2026 Académie Mission Formations
</div>
